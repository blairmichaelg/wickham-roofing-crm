# ============================================================
# Wickham Roofing AI Orchestrator — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# === Webhook Security ===
# Shared secret for the x-api-key header validation on inbound webhooks.
# Webhooks are authenticated via our custom HMAC-like auth layer.
WEBHOOK_SECRET=your_shared_x_api_key_secret_here

# === API Authentication ===
# Distinct tokens for internal microservice routing to prevent cross-domain access.
OFFICE_INTERNAL_TOKEN=office-secret-token
FIELD_INTERNAL_TOKEN=field-secret-token

# === Redis (Render Internal Key-Value Store) ===
# Use the internal connection URL from your Render dashboard.
# Format: redis://<host>:<port>
REDIS_URL=redis://localhost:6379

# === Google Gemini AI ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Application Settings ===
APP_ENV=development
LOG_LEVEL=DEBUG

# The CRM status name used to quarantine test jobs.
# Only webhooks matching this status will be processed.
QUARANTINE_STATUS=API TEST LAB

# === Real-Time Storm Ingestion & Alerting ===
# Location of the primary office center for monitoring
STORM_OFFICE_LAT=30.8766
STORM_OFFICE_LON=-84.1994

# Radius boundary for weather report ingestion in miles
STORM_INGEST_RADIUS_MILES=50

# Radius boundary for triggering active alerts in miles
STORM_ALERT_RADIUS_MILES=30

# Alert threshold criteria
STORM_ALERT_MIN_HAIL_INCHES=1.0
STORM_ALERT_MIN_WIND_MPH=58

# Ingestion frequency in minutes
STORM_INGEST_INTERVAL_MINUTES=15

# === Web Push / VAPID Notifications ===
# Generate VAPID keypair via `openssl ecparam -name prime256v1 -genkey` or `pywebpush` CLI
VAPID_PUBLIC_KEY=your_vapid_public_key_base64url
VAPID_PRIVATE_KEY=your_vapid_private_key_base64url
VAPID_CLAIM_EMAIL=mailto:admin@wickhamroofing.com


